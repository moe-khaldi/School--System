@model UniversityCourseEnrollment.Controllers.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="admin-title">Admin Dashboard</h1>
<p class="lead">Welcome, @User.Identity?.Name.</p>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="dashboard-cards">
    
        <div class="card p-3 dashboard-stat-card">
        <h1>Courses</h1>
        <h2>@Model.CourseCount</h2>
        
        <a asp-controller="Courses" asp-action="Index" class="text-decoration-none text-dark">
            <small class="dashboard-card-action">View all courses</small>
        </a>
        
    </div>
    
   
    
    
    
        <div class="card p-3 dashboard-stat-card">
        <h1>Teachers</h1>
        <h2>@Model.TeacherCount</h2>
        
        <a asp-controller="Admin" asp-action="Teachers" class="text-decoration-none text-dark">
            <small class="dashboard-card-action">View all teachers</small>
        </a>
        
     </div>
     
   
    
     
    
        <div class="card p-3 dashboard-stat-card">
        <h1>Students</h1>
        <h2>@Model.StudentCount</h2>
        
        <a asp-controller="Admin" asp-action="Students" class="text-decoration-none text-dark">
            <small class="dashboard-card-action">View all students</small>
        </a>
        
       </div>
      
    
     
        <div class="card p-3 dashboard-stat-card">
        <h1>Enrollments</h1>
        <h2>@Model.EnrollmentCount</h2>
        <a asp-controller="Admin" asp-action="Enrollments" class="text-decoration-none text-dark">
            <small class="dashboard-card-action">View all enrollments</small>
        </a>
        

     
    </div>
    
</div>
<div class="lower-dashboard-cards">
    <div class="actions-card">
        <label class="actions-card-label">Actions</label>
        <div class="d-flex flex-column gap-2">
            <a asp-controller="Admin" asp-action="CreateCourse" class="btn btn-primary gold-btn">Create course</a>
            <a></a>
            <a></a>
            <a asp-controller="Admin" asp-action="AssignTeacher" class="btn btn-outline-primary gold-btn">Assign teacher</a>
            <a></a>
            <a></a>
            <a asp-controller="Admin" asp-action="StudentGpa" class="btn btn-outline-primary gold-btn">Student GPA</a>
            <a></a>
            <a></a>
            <a asp-controller="Admin" asp-action="HonorBoard" class="btn btn-outline-primary gold-btn">Honor board</a>
        
    </div>
    </div>
</div>
