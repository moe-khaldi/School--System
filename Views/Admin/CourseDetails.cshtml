@model UniversityCourseEnrollment.Models.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = "Course Details";
    var activationDisabledReason = Model.Course.IsCancelled
        ? "Cancelled courses cannot be activated."
        : Model.Course.IsActive
            ? "This course is already active."
            : Model.Course.EndDate.Date < DateTime.UtcNow.Date
                ? "This course has ended and cannot be activated."
                : null;
}

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="d-flex justify-content-between"><h1>@Model.Course.CourseCode - @Model.Course.CourseName</h1><a asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">Dashboard</a></div>
<dl class="row">
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@(Model.Course.Description ?? "Not specified")</dd>
    <dt class="col-sm-3">Dates</dt><dd class="col-sm-9">@Model.Course.StartDate.ToString("yyyy-MM-dd") to @Model.Course.EndDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Credit hours</dt><dd class="col-sm-9">@Model.Course.CreditHours</dd>
    <dt class="col-sm-3">Average grade</dt><dd class="col-sm-9">@(Model.AverageGrade?.ToString("0.##") ?? "No grades yet")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@(Model.Course.IsCancelled ? "Cancelled" : Model.Course.IsActive ? "Active" : "Inactive")</dd>
</dl>

<div class="mb-4">
    <form asp-action="ActivateCourse" asp-route-id="@Model.Course.CourseId" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn activate-course-btn"
                disabled="@(activationDisabledReason is not null)"
                aria-describedby="@(activationDisabledReason is not null ? "activation-disabled-reason" : null)">Activate course</button>
    </form>
    @if (activationDisabledReason is not null)
    {
        <p id="activation-disabled-reason" class="text-muted mt-2">@activationDisabledReason</p>
    }
    <a asp-action="AssignTeacher" asp-route-courseId="@Model.Course.CourseId" class="btn btn-primary gold-btn">Assign teacher</a>
    <a asp-action="CourseAverage" asp-route-id="@Model.Course.CourseId" class="btn btn-outline-primary gold-btn">View average</a>
    @if (!Model.Course.IsCancelled)
    {
        <form asp-action="CancelCourseIfLowEnrollment" asp-route-id="@Model.Course.CourseId" method="post" class="d-inline" onsubmit="return confirm('Cancel this course if it has fewer than 5 active students?');">
            @Html.AntiForgeryToken()<button type="submit" class="btn btn-outline-danger red-btn">Cancel if fewer than 5</button>
        </form>
    }
</div>

<h2>Assigned teachers</h2>
<ul>@foreach (var assignment in Model.Course.CourseTeachers) { <li>@assignment.Teacher.AppUser.FullName</li> }</ul>
<h2>Enrollments (@Model.Enrollments.TotalCount)</h2>
<table class="table" id="courseEnrollmentsTable" data-page-sort><thead><tr><th data-sort-type="text">Student</th><th data-sort-type="date">Enrollment date</th><th>Status</th><th>Grade</th></tr></thead><tbody>
@foreach (var enrollment in Model.Enrollments.Items) { <tr><td>@enrollment.Student.AppUser.FullName</td><td data-sort-value="@enrollment.EnrollmentDate.ToString("O")">@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td><td>@enrollment.Status</td><td>@(enrollment.Grade?.ToString("0.##") ?? "Not graded")</td></tr> }
</tbody></table>
<partial name="_Pagination" model="Model.Enrollments" />
