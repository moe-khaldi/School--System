@model IEnumerable<UniversityCourseEnrollment.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Students</h1>
        <p class="text-muted mb-0">View all registered students.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
</div>

<div class="mb-3">
    <label for="studentSearch" class="form-label">Search students</label>
    <input id="studentSearch" type="search" class="form-control" placeholder="Search by name or university number..." autocomplete="off" />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="studentsTable">
        <thead class="table-dark">
            <tr><th>Name</th><th>Email</th><th>University number</th><th>Enrollments</th><th>Reports</th></tr>
        </thead>
        <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.AppUser.FullName</td>
                <td>@student.AppUser.Email</td>
                <td>@student.UniversityNumber</td>
                <td>@student.Enrollments.Count</td>
                <td>
                    <a asp-controller="Admin" asp-action="StudentGpa" asp-route-studentId="@student.StudentId" class="btn btn-sm btn-outline-primary">GPA</a>
                    <a asp-controller="Admin" asp-action="StudentEnrollments" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-secondary">Courses</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById("studentSearch")?.addEventListener("input", function () {
            const text = this.value.toLowerCase().trim();
            document.querySelectorAll("#studentsTable tbody tr").forEach(row => {
                row.hidden = !row.textContent.toLowerCase().includes(text);
            });
        });
    </script>
}
