@model PaginatedList<Student>

@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Students</h1>
        <p class="text-muted mb-0">View all registered students.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">Back to dashboard</a>
</div>

<form method="get" asp-action="Students" class="search mb-3">
    <label for="search" class="form-label">Search students</label>
    <input id="search" name="search" value="@ViewData["Search"]" type="search"
           class="form-control" placeholder="Search by name, email, or university number..." />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <button type="submit" class="btn btn-primary mt-2 search-btn">Search</button>
    <a asp-action="Students" class="btn btn-outline-secondary mt-2 clear-btn">Clear</a>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="studentsTable">
        <thead class="table-dark">
            <tr><th>Name</th><th>Email</th><th>University number</th><th>Enrollments</th><th>Reports</th></tr>
        </thead>
        <tbody>
        @foreach (var student in Model.Items)
        {
            <tr>
                <td>@student.AppUser.FullName</td>
                <td>@student.AppUser.Email</td>
                <td>@student.UniversityNumber</td>
                <td>@student.Enrollments.Count</td>
                <td>
                    <a asp-controller="Admin" asp-action="StudentGpa" asp-route-studentId="@student.StudentId" class="btn btn-sm btn-outline-primary gold-btn">GPA</a>
                    <a asp-controller="Admin" asp-action="StudentEnrollments" asp-route-id="@student.StudentId" class="btn btn-sm btn-outline-secondary gold-btn">Courses</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
