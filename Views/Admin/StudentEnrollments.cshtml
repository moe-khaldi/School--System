@model UniversityCourseEnrollment.Models.ViewModels.StudentEnrollmentsReportViewModel
@{ ViewData["Title"] = "Student Enrollments"; }
<h1>Student Enrollments</h1><h2>@Model.StudentName</h2>
<form method="get" class="row g-2 mb-4"><input type="hidden" name="id" value="@Model.StudentId" /><div class="col-md-4"><label class="form-label">From</label><input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4"><label class="form-label">To</label><input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Filter</button></div></form>
<table class="table table-striped"><thead><tr><th>Course</th><th>Enrollment timeframe</th><th>Status</th><th>Grade</th></tr></thead><tbody>@foreach (var enrollment in Model.Enrollments) { <tr><td>@enrollment.Course.CourseCode - @enrollment.Course.CourseName</td><td>@enrollment.EnrollmentStartDate.ToString("yyyy-MM-dd") to @enrollment.EnrollmentEndDate.ToString("yyyy-MM-dd")</td><td>@enrollment.Status</td><td>@(enrollment.Grade?.ToString("0.##") ?? "Not graded")</td></tr> }</tbody></table>
