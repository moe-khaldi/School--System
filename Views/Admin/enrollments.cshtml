@model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Enrollments</h1>
        <p class="text-muted mb-0">Review student course enrollment records.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">Back to dashboard</a>
</div>

<form method="get" asp-action="Enrollments" class="mb-3">
    <label for="search" class="form-label">Search enrollments</label>
    <input id="search" name="search" value="@ViewData["Search"]" type="search"
           class="form-control" placeholder="Search by student or course..." />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <button type="submit" class="btn btn-primary mt-2 gold-btn">Search</button>
    <a asp-action="Enrollments" class="btn btn-outline-secondary mt-2 gold-btn">Clear</a>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="enrollmentsTable" data-page-sort>
        <thead class="table-dark">
            <tr><th data-sort-type="text">Student</th><th>Course</th><th data-sort-type="date">Enrollment date</th><th>Status</th><th>Grade</th></tr>
        </thead>
        <tbody>
        @foreach (var enrollment in Model.Items)
        {
            <tr>
                <td>@enrollment.Student.AppUser.FullName</td>
                <td>@enrollment.Course.CourseCode - @enrollment.Course.CourseName</td>
                <td data-sort-value="@enrollment.EnrollmentDate.ToString("O")">@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                <td>@enrollment.Status</td>
                <td>@(enrollment.Grade?.ToString("0.##") ?? "Not graded")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="Model" />
