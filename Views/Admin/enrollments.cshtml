@model IEnumerable<UniversityCourseEnrollment.Models.Enrollment>

@{
    ViewData["Title"] = "Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Enrollments</h1>
        <p class="text-muted mb-0">Review student course enrollment records.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
</div>

<div class="mb-3">
    <label for="enrollmentSearch" class="form-label">Search enrollments</label>
    <input id="enrollmentSearch" type="search" class="form-control" placeholder="Search by student or course..." autocomplete="off" />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover" id="enrollmentsTable">
        <thead class="table-dark">
            <tr><th>Student</th><th>Course</th><th>Enrollment date</th><th>Status</th><th>Grade</th></tr>
        </thead>
        <tbody>
        @foreach (var enrollment in Model)
        {
            <tr>
                <td>@enrollment.Student.AppUser.FullName</td>
                <td>@enrollment.Course.CourseCode - @enrollment.Course.CourseName</td>
                <td>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                <td>@enrollment.Status</td>
                <td>@(enrollment.Grade?.ToString("0.##") ?? "Not graded")</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById("enrollmentSearch")?.addEventListener("input", function () {
            const text = this.value.toLowerCase().trim();
            document.querySelectorAll("#enrollmentsTable tbody tr").forEach(row => {
                row.hidden = !row.textContent.toLowerCase().includes(text);
            });
        });
    </script>
}
