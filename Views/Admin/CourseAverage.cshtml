@model UniversityCourseEnrollment.Models.ViewModels.CourseDetailsViewModel
@{ ViewData["Title"] = "Course Average"; }
<h1>Course Average</h1><div class="card p-4"><h2>@Model.Course.CourseCode - @Model.Course.CourseName</h2><p class="display-6">Average: @(Model.AverageGrade?.ToString("0.##") ?? "No grades yet")</p><a asp-action="CourseDetails" asp-route-id="@Model.Course.CourseId" class="btn btn-secondary">Course details</a></div>
