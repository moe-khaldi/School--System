@model PaginatedList<Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Teachers</h1>
        <p class="text-muted mb-0">View the teachers registered in the university system.</p>
    </div>

    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">
        Back to dashboard
    </a>
</div>

<form method="get" asp-action="Teachers" class="mb-3">
    <label for="search" class="form-label">Search teachers</label>
    <input id="search" name="search" value="@ViewData["Search"]" type="search"
           class="form-control" placeholder="Search by name, email, or department..." />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <button type="submit" class="btn btn-primary mt-2 gold-btn">Search</button>
    <a asp-action="Teachers" class="btn btn-outline-secondary mt-2 gold-btn">Clear</a>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">No teachers were found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="teachersTable">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Courses taught</th>
                    <th>Reports</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in Model.Items)
                {
                    <tr>
                        <td>@teacher.AppUser.FullName</td>
                        <td>@teacher.AppUser.Email</td>
                        <td>@(teacher.Department ?? "Not specified")</td>
                        <td>@teacher.CourseTeachers.Count</td>
                        <td>
                            <a asp-controller="Admin" asp-action="TeacherCurrentCourses" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-outline-primary gold-btn">Current courses</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pagination" model="Model" />
