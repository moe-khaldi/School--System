@model IEnumerable<UniversityCourseEnrollment.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Teachers</h1>
        <p class="text-muted mb-0">View the teachers registered in the university system.</p>
    </div>

    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
        Back to dashboard
    </a>
</div>

<div class="mb-3">
    <label for="teacherSearch" class="form-label">Search teachers</label>
    <input id="teacherSearch"
           type="search"
           class="form-control"
           placeholder="Search by name, email, or department..."
           autocomplete="off" />
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No teachers were found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle" id="teachersTable">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Courses taught</th>
                    <th>Reports</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in Model)
                {
                    <tr>
                        <td>@teacher.AppUser.FullName</td>
                        <td>@teacher.AppUser.Email</td>
                        <td>@(teacher.Department ?? "Not specified")</td>
                        <td>@teacher.CourseTeachers.Count</td>
                        <td>
                            <a asp-controller="Admin" asp-action="TeacherCurrentCourses" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-outline-primary">Current courses</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        const searchInput = document.getElementById("teacherSearch");
        const rows = document.querySelectorAll("#teachersTable tbody tr");

        searchInput?.addEventListener("input", function () {
            const searchText = this.value.toLowerCase().trim();

            rows.forEach(row => {
                row.hidden = !row.textContent.toLowerCase().includes(searchText);
            });
        });
    </script>
}
