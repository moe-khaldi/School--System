@model IEnumerable<UniversityCourseEnrollment.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Courses</h1>
        <p class="text-muted mb-0">View all courses in the university system.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">Back to dashboard</a>
</div>

<div class="mb-3">
    <label for="courseSearch" class="form-label">Search courses</label>
    <input id="courseSearch" type="search" class="form-control" placeholder="Search by code or name..." autocomplete="off" />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle" id="coursesTable">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Credit hours</th>
                <th>Dates</th>
                <th>Status</th>
                <th>Enrollments</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>@course.CourseCode</td>
                <td>@course.CourseName</td>
                <td>@course.CreditHours</td>
                <td>@course.StartDate.ToString("yyyy-MM-dd") to @course.EndDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (course.IsCancelled)
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else if (course.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>@course.Enrollments.Count</td>
                <td><a asp-controller="Admin" asp-action="CourseDetails" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-primary">Details</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById("courseSearch")?.addEventListener("input", function () {
            const text = this.value.toLowerCase().trim();
            document.querySelectorAll("#coursesTable tbody tr").forEach(row => {
                row.hidden = !row.textContent.toLowerCase().includes(text);
            });
        });
    </script>
}
