@model UniversityCourseEnrollment.Controllers.StudentDashboardViewModel

@{
    ViewData["Title"] = "Student Dashboard";
}

<h1>Student Dashboard</h1>
<p>Welcome, @Model.StudentName.</p>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="card p-3 mb-3 dashboard-cards">
    <h2>@Model.EnrollmentCount</h2>
    <p>Course enrollments</p>
</div>

<div class="d-flex gap-2 flex-wrap">
    <a asp-action="OpenCourses" class="btn btn-primary gold-btn">View open courses</a>
    <a asp-action="MyCourses" class="btn btn-outline-primary gold-btn">My courses</a>
</div>
