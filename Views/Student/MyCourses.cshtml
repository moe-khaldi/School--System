@model UniversityCourseEnrollment.Models.ViewModels.StudentEnrollmentsViewModel
@{ ViewData["Title"] = "My Courses"; }

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>My Courses</h1><p class="text-muted">Your enrollment history and current courses.</p></div><a asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">Dashboard</a></div>
@if (!Model.Enrollments.Any()) { <div class="alert alert-info">You are not enrolled in any courses.</div> }
else { <div class="table-responsive"><table class="table table-striped table-hover"><thead class="table-dark"><tr><th>Course</th><th>Enrollment date</th><th>Timeframe</th><th>Status</th><th>Grade</th></tr></thead><tbody>
@foreach (var enrollment in Model.Enrollments)
{
    <tr><td>@enrollment.Course.CourseCode - @enrollment.Course.CourseName</td><td>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td><td>@enrollment.EnrollmentStartDate.ToString("yyyy-MM-dd") to @enrollment.EnrollmentEndDate.ToString("yyyy-MM-dd")</td><td>@enrollment.Status</td><td>@(enrollment.Grade?.ToString("0.##") ?? "Not graded")</td></tr>
}
</tbody></table></div> }
