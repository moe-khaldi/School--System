@model UniversityCourseEnrollment.Models.ViewModels.StudentCoursesViewModel
@{ ViewData["Title"] = "Open Courses"; }

<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Open Courses</h1><p class="text-muted">Courses currently active and within their valid dates.</p></div><a asp-action="Dashboard" class="btn btn-outline-secondary gold-btn">Dashboard</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="mb-3"><label for="courseSearch" class="form-label">Search courses</label><input id="courseSearch" type="search" class="form-control" placeholder="Search by code or name..." autocomplete="off" /></div>

@if (!Model.Courses.Any()) { <div class="alert alert-info">There are no open courses at the moment.</div> }
else { <div class="table-responsive"><table class="table table-striped table-hover" id="openCoursesTable"><thead class="table-dark"><tr><th>Code</th><th>Course</th><th>Description</th><th>Credits</th><th>Dates</th><th>Action</th></tr></thead><tbody>
@foreach (var course in Model.Courses)
{
    var alreadyEnrolled = course.Enrollments.Any(e => e.StudentId == Model.StudentId);
    <tr><td>@course.CourseCode</td><td>@course.CourseName</td><td>@(course.Description ?? "-")</td><td>@course.CreditHours</td><td>@course.StartDate.ToString("yyyy-MM-dd") to @course.EndDate.ToString("yyyy-MM-dd")</td>
        <td>
            <form asp-action="Enroll" asp-route-id="@course.CourseId" method="post" onsubmit="return confirm('Enroll in this course?');">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm @(alreadyEnrolled ? "btn-secondary" : "btn-primary gold-btn")" type="submit" disabled="@alreadyEnrolled"
                        title="@(alreadyEnrolled ? "You already have an enrollment record for this course." : "Enroll in this course")">
                    @(alreadyEnrolled ? "Already enrolled" : "Enroll")
                </button>
            </form>
        </td>
    </tr>
}
</tbody></table></div> }

@section Scripts { <script>document.getElementById("courseSearch")?.addEventListener("input", function () { const text = this.value.toLowerCase().trim(); document.querySelectorAll("#openCoursesTable tbody tr").forEach(row => row.hidden = !row.textContent.toLowerCase().includes(text)); });</script> }
