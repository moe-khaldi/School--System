@model UniversityCourseEnrollment.Controllers.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<h1>Teacher Dashboard</h1>
<p>Welcome, @Model.TeacherName.</p>

<div class="card p-3 mb-3 dashboard-cards">
    <h2>@Model.CourseCount</h2>
    <p>Assigned courses</p>
</div>

<div class="d-flex gap-2 flex-wrap">
    <a asp-action="MyCourses" class="btn btn-primary gold-btn">My courses</a>
    <a asp-action="CurrentCourses" class="btn btn-outline-primary gold-btn">Current courses</a>
</div>
