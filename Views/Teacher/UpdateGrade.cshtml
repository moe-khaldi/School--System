@model UniversityCourseEnrollment.Models.ViewModels.UpdateGradeViewModel
@{ ViewData["Title"] = "Update Grade"; }

<h1>Update Grade</h1>
<p><strong>Student:</strong> @Model.StudentName</p>
<p><strong>Course:</strong> @Model.CourseName</p>
<form asp-action="UpdateGrade" method="post" class="col-md-5">
    @Html.AntiForgeryToken()
    <input asp-for="EnrollmentId" type="hidden" /><input asp-for="CourseId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Grade" class="form-label">Grade (0-100)</label>
    <input asp-for="Grade" class="form-control" min="0" max="100" step="0.01" />
    <span asp-validation-for="Grade" class="text-danger"></span>
    <p class="form-text">Leave the grade empty to return the enrollment to Enrolled status.</p>
    <button type="submit" class="btn btn-primary gold-btn">Save grade</button>
    <a asp-action="CourseStudents" asp-route-id="@Model.CourseId" class="btn btn-secondary gold-btn">Cancel</a>
</form>
